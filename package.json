{
  "name": "kodsdoor-quan-ly-kho-cloudflare",
  "version": "5.8.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --persist-to .wrangler/state",
    "check": "node --check src/worker.js",
    "db:local": "wrangler d1 migrations apply DB --local --persist-to .wrangler/state",
    "db:remote": "wrangler d1 migrations apply DB --remote",
    "test": "npm run check && node --test tests/*.test.mjs",
    "deploy": "npm test && wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "^4.26.0"
  },
  "engines": {
    "node": ">=20"
  }
}
